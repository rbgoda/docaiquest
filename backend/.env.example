# DocAIQ backend env. Copy to .env for local dev OR rely on docker-compose
# / Helm to inject these. Generated from app/config.py Settings so the
# list stays in sync with what the code actually reads (TODO #39).
# In production, these are injected by the deployment system (Helm values,
# ECS task definition, GitHub Actions secrets, etc.) — one set per tenant.

# ─── Identity ─────────────────────────────────────────────────────────────
DOCAIQ_TENANT_ID=default
DOCAIQ_ENVIRONMENT=development          # development | staging | production
DOCAIQ_LICENSE_MODE=oss                  # oss (self-hosted, default) | cloud (managed SaaS)

# ─── Auth / sessions ──────────────────────────────────────────────────────
# REQUIRED. Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Refused at boot if shorter than 32 chars or starts with dev-/ci-/test-
# while DOCAIQ_ENVIRONMENT=production. See TODO #1.
DOCAIQ_JWT_SECRET=
DOCAIQ_JWT_TTL_SECONDS=28800            # 8 hours
DOCAIQ_AUTH_PROVIDER=dev                # dev | google | oidc
DOCAIQ_PUBLIC_URL=http://localhost:8080

# Optional · Google OIDC
DOCAIQ_GOOGLE_CLIENT_ID=
DOCAIQ_GOOGLE_CLIENT_SECRET=

# Optional · generic OIDC (WorkOS/Auth0/Okta/Keycloak)
DOCAIQ_OIDC_ISSUER=
DOCAIQ_OIDC_AUDIENCE=
DOCAIQ_OIDC_JWKS_URL=

# Cookie name — change only if you must avoid a collision with another app
# sharing the same origin.
DOCAIQ_SESSION_COOKIE_NAME=docaiq_session

# CORS — JSON-encoded list. Add every origin the browser will load from.
DOCAIQ_CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]

# ─── Database ─────────────────────────────────────────────────────────────
DOCAIQ_DATABASE_URL=postgresql+psycopg://docaiq:docaiq-dev@postgres:5432/docaiq

# ─── Object storage ───────────────────────────────────────────────────────
DOCAIQ_S3_ENDPOINT=http://minio:9000
DOCAIQ_S3_ACCESS_KEY=docaiq
DOCAIQ_S3_SECRET_KEY=docaiq-dev-secret-please-rotate
DOCAIQ_S3_BUCKET=docaiq-default
DOCAIQ_S3_REGION=us-east-1
DOCAIQ_MAX_UPLOAD_BYTES=104857600       # 100 MB

# Defensive cap on list endpoints (TODO #14) — protects against runaway
# multi-MB responses before the Paginated[T] envelope ships.
DOCAIQ_MAX_LIST_ROWS=1000

# ─── Bootstrap owner (control-plane provisioning) ─────────────────────────
# When set, the seed creates exactly this user as the tenant's sole owner.
# Leave empty for dev — seed.py creates the default elena/james/marcus trio.
DOCAIQ_BOOTSTRAP_OWNER_EMAIL=
DOCAIQ_BOOTSTRAP_OWNER_NAME=
DOCAIQ_BOOTSTRAP_OWNER_PASSWORD=

# Demo data — `true` seeds Atlas Logistics et al, `false` is a clean
# workspace (used by control-plane-provisioned customer tenants).
DOCAIQ_SEED_DEMO_DATA=true

# ─── Worker / Redis ───────────────────────────────────────────────────────
DOCAIQ_REDIS_URL=redis://redis:6379/0

# ─── Embeddings (M7) ──────────────────────────────────────────────────────
DOCAIQ_EMBED_BACKEND=hash               # hash (dev, no deps) | openai (real)
DOCAIQ_EMBED_DIM=384                    # MUST match the column type baked at migration time
DOCAIQ_OPENAI_API_KEY=
DOCAIQ_OPENAI_EMBED_MODEL=text-embedding-3-small
DOCAIQ_CHUNK_TARGET_CHARS=1000
DOCAIQ_CHUNK_OVERLAP_CHARS=150

# ─── LLM gateway (M9) ─────────────────────────────────────────────────────
# Any/all may be empty — gateway falls back to stub. OpenRouter recommended
# (covers Gemini, Claude, GPT-OSS, Qwen, Llama via one key).
DOCAIQ_OPENROUTER_API_KEY=
DOCAIQ_ANTHROPIC_API_KEY=
DOCAIQ_GOOGLE_GENAI_API_KEY=
DOCAIQ_GOOGLE_DRIVE_API_KEY=
# OpenRouter HTTP-Referer + X-Title (their abuse-tracking on free tiers)
DOCAIQ_OPENROUTER_REFERER=https://docaiq.io
DOCAIQ_OPENROUTER_APP_TITLE=DocAIQ
# Per-call timeout — bounds how long a hung provider can stall the request.
DOCAIQ_LLM_REQUEST_TIMEOUT=60
