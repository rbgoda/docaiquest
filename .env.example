# ═══════════════════════════════════════════════════════════════════════════════
# DocAIQuest — environment template
# Copy to .env and fill in before `make up`.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Required ─────────────────────────────────────────────────────────────────
DOCAIQ_PRODUCT=documents
DOCAIQ_TENANT_ID=docmod
DOCAIQ_JWT_SECRET=change-me-to-a-long-random-string
DOCAIQ_HOST_PORT=8085

# ── Auth ─────────────────────────────────────────────────────────────────────
DOCAIQ_AUTH_PROVIDER=dev              # dev | google
DOCAIQ_SESSION_COOKIE_NAME=docaiq_session
DOCAIQ_JWT_TTL_SECONDS=28800
# DOCAIQ_SESSION_REVOCATION=true      # opt-in DB-backed token revocation

# ── Database & Redis ─────────────────────────────────────────────────────────
DOCAIQ_DATABASE_URL=postgresql://docaiquest:docaiquest-dev@postgres:5432/docaiquest
DOCAIQ_REDIS_URL=redis://redis:6379

# ── Object Storage (MinIO / S3-compatible) ───────────────────────────────────
DOCAIQ_S3_ENDPOINT=minio:9000
DOCAIQ_S3_ACCESS_KEY=docaiquest
DOCAIQ_S3_SECRET_KEY=docaiquest-dev-secret-please-rotate
DOCAIQ_S3_BUCKET=docaiquest-default
DOCAIQ_S3_REGION=us-east-1

# ── Embedding & Reranker ─────────────────────────────────────────────────────
# local (all-MiniLM-L6-v2, 384d, CPU, free) | hash | openai | gemini | dashscope
DOCAIQ_EMBED_BACKEND=local
# dashscope (BGE-M3, 1024d) — set DOCAIQ_EMBED_DIM=1024 + DOCAIQ_EMBED_V2_ACTIVE=true
# DOCAIQ_EMBED_DIM=384
# DOCAIQ_RERANKER_ENABLED=true
# DOCAIQ_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ── Chunking ─────────────────────────────────────────────────────────────────
# DOCAIQ_CHUNK_TARGET_CHARS=800
# DOCAIQ_CHUNK_OVERLAP_CHARS=150

# ── LLM Providers (set keys for features you want to enable) ─────────────────
# DOCAIQ_OPENROUTER_API_KEY=sk-or-v1-...
# DOCAIQ_DASHSCOPE_API_KEY=sk-...
# DOCAIQ_ANTHROPIC_API_KEY=sk-ant-...
# DOCAIQ_OPENAI_API_KEY=sk-...
# DOCAIQ_GOOGLE_GENAI_API_KEY=...

# ── Google Drive (OAuth 2.0 + connector) ─────────────────────────────────────
# DOCAIQ_GOOGLE_CLIENT_ID=...
# DOCAIQ_GOOGLE_CLIENT_SECRET=...
# DOCAIQ_GOOGLE_DRIVE_API_KEY=...
# DOCAIQ_DRIVE_BACKEND=google
# DOCAIQ_PUBLIC_URL=https://your-domain.com
# DOCAIQ_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── Email (Resend) ───────────────────────────────────────────────────────────
# DOCAIQ_RESEND_API_KEY=re_...
# DOCAIQ_EMAIL_FROM=DocAIQuest <noreply@your-domain.com>
# DOCAIQ_DOCUMENTS_SUPERADMIN_EMAILS=admin@example.com

# ── Seed / Bootstrap ─────────────────────────────────────────────────────────
DOCAIQ_SEED_DEMO_DATA=false
# DOCAIQ_BOOTSTRAP_OWNER_EMAIL=
# DOCAIQ_BOOTSTRAP_OWNER_NAME=
# DOCAIQ_BOOTSTRAP_OWNER_PASSWORD=

# ── LLM Cost Guard ───────────────────────────────────────────────────────────
# DOCAIQ_DOCUMENTS_USER_HOURLY_LLM_CAP=60
# DOCAIQ_DOCUMENTS_DAILY_LLM_CAP=5000
# DOCAIQ_DOCUMENTS_ENTERPRISE_HOURLY_LLM_CAP=100

# ── Extraction & Classification ──────────────────────────────────────────────
# DOCAIQ_CLASSIFIER_MODEL=openrouter/qwen/qwen-2.5-7b-instruct
# DOCAIQ_NER_BACKEND=regex              # regex | llm | both
# DOCAIQ_NER_MODEL=anthropic/claude-haiku-4.5
# DOCAIQ_DOCUMENTS_CATEGORIZE_MODEL=dashscope/qwen-max
# DOCAIQ_DOCUMENTS_EXTRACT_VERIFY=true
# DOCAIQ_SCHEMA_CRYSTALLIZE_ENABLED=false

# ── Chat (doc + workspace) ───────────────────────────────────────────────────
# DOCAIQ_CHAT_QUERY_ROUTING=true
# DOCAIQ_DOCUMENTS_AGENT_FALLBACK=true
# DOCAIQ_DOCUMENTS_CHAT_GUARDRAIL=true
# DOCAIQ_CONTEXTUAL_RETRIEVAL_ENABLED=true
# DOCAIQ_CHAT_CLAIM_VERIFICATION=true
# DOCAIQ_DOCUMENTS_CRITIC_ENABLED=false

# ── Ingest — PDF / Office / OCR / Vision ─────────────────────────────────────
# DOCAIQ_DOCUMENTS_FIGURE_EXTRACTION=false
# DOCAIQ_DOCUMENTS_OFFICE_IMAGE_OCR=true
# DOCAIQ_DOCUMENTS_DOCLING_ENABLED=false
# DOCAIQ_DOCUMENTS_MULTIPASS_OCR=false
# DOCAIQ_DOCUMENTS_MAX_OCR_PAGES=50

# ── PII & Privacy ────────────────────────────────────────────────────────────
# DOCAIQ_PII_REDACT_BEFORE_LLM=true
# DOCAIQ_PII_PROTECT_AT_REST=true
# DOCAIQ_DOCUMENTS_DRIVE_ENCRYPTION=true

# ── AIQ Suite SSO ────────────────────────────────────────────────────────────
# DOCAIQ_JICAMA_SSO_SECRET=

# ── External API / MCP ───────────────────────────────────────────────────────
# DOCAIQ_EXTRACTION_API_KEY=ek_...

# ── Fleet (control-plane member heartbeat) ───────────────────────────────────
# DOCAIQ_FLEET_ADMIN_URL=
# DOCAIQ_FLEET_TOKEN=

# ── Misc ─────────────────────────────────────────────────────────────────────
# DOCAIQ_ENVIRONMENT=development
# DOCAIQ_LLM_REQUEST_TIMEOUT=120
# DOCAIQ_DOCUMENTS_LLM_BBOX_FALLBACK=true
# DOCAIQ_DOCUMENTS_DRIVE_AUTOSYNC=false
# DOCAIQ_DOCUMENTS_DRIVE_AUTOBACKUP=false
# DOCAIQ_DOCUMENTS_RETENTION_PURGE_DAYS=0
# DOCAIQ_MAX_LIST_ROWS=100
# DOCAIQ_MAX_UPLOAD_BYTES=104857600
# DOCAIQ_SEMANTIC_CHUNKING=true
# DOCAIQ_ENTITY_TYPE_RESOLVER=true
# DOCAIQ_GRAPH_RETRIEVAL_ENABLED=true
# DOCAIQ_REFLEXION_CACHE_ENABLED=true
